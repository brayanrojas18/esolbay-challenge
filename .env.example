# --- Base de datos -----------------------------------------------------------
# Supabase: boton Connect -> Direct Connection.
#
# Cual de las tres strings usar, en orden de preferencia:
#   1. Session pooler     (5432) - la mejor: soporta prepared statements.
#   2. Transaction pooler (6543) - funciona, pero exige prepare:false en el
#      cliente (ya contemplado en src/db/client.ts). Usar si 5432 esta
#      bloqueado por firewall, que es lo comun en redes hogarenias.
#   3. Direct connection  (5432, db.<ref>.supabase.co) - solo IPv6 en el plan
#      free, no resuelve desde la mayoria de las redes.
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# --- Proveedor de IA ---------------------------------------------------------
# Todo es OPCIONAL: sin credenciales el pipeline corre igual con --dry-run,
# usando los proveedores locales deterministicos. Ver README.
#
# Valores soportados: openai | google
AI_PROVIDER=google

# Segun el proveedor elegido, completar UNA de estas dos:
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# Los modelos tienen default por proveedor, asi que estas tres lineas se pueden
# borrar. Se dejan explicitas porque los nombres de modelo cambian seguido.
#
#   google -> gemini-3.6-flash / gemini-embedding-001
#   openai -> gpt-4o-mini      / text-embedding-3-small
LLM_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001

# Dimension de los vectores. Tiene que coincidir con las columnas vector() de la
# base: la migracion la sustituye al aplicarse, y hay una verificacion que falla
# temprano si no coinciden.
#
# gemini-embedding-001 admite pedirle 1536, que es lo que usa OpenAI. Asi se
# puede cambiar de proveedor sin migrar el schema ni regenerar todo.
EMBEDDING_DIMENSIONS=1536
